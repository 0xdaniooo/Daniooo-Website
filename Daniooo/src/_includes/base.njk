<!DOCTYPE html>
<html lang="en">
    <head>
        <title>{% block title %}{% if title %}Daniooo | {{ title }}{% else %}Daniooo{% endif %}{% endblock %}</title>
        <link rel="icon" type="image/x-icon" href="/content/misc/Daniooo.webp">
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <meta name="description" content="Welcome to Daniooo. Here you can see the software I've worked on, various articles I've written, media I've taken and anything else related to me.">
		<meta name="keywords" content="daniooo, programmer, computer science, computer security, cybersecurity, psychology, technology, productivity, photography">
		<meta name="author" content="Daniel Kasprzyk">

        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
        <link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=Readex+Pro:wght@160..700&display=swap" rel="stylesheet">
        <script src="https://kit.fontawesome.com/9075ca7894.js" crossorigin="anonymous"></script>
        {% if env.isProduction and env.cloudflareToken %}
        <script defer src='https://static.cloudflareinsights.com/beacon.min.js' data-cf-beacon='{"token": "{{ env.cloudflareToken }}"}'></script>
        {% endif %}

        <link rel="stylesheet" href="/css/base.css">
        {% if stylesheet %}
        <link rel="stylesheet" href="/css/{{ stylesheet }}">
        {% endif %}
    </head>
    <body>
        <nav class="navbar navbar-expand-md sticky-top">
            <div class="container-fluid">
                <a {% if page.url == '/' %}id="current-page"{% endif %} class="navbar-brand" href="/"><img src="/content/misc/Daniooo.webp" alt="Daniooo logo" class="nav-logo d-inline-block align-text-center">Daniooo</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarResponsive">
                    <i class="fa-solid fa-bars fa-lg"></i>
                </button>
                <div id="navbarResponsive" class="collapse navbar-collapse justify-content-end">
                    <ul class="navbar-nav align-items-center">
                        <li class="nav-item active">
                            <a {% if page.url == '/software/' %}id="current-page"{% endif %} class="nav-link" href="/software/">Software</a>
                        </li>
                        <li class="nav-item">
                            <a {% if page.url == '/articles/' %}id="current-page"{% endif %} class="nav-link" href="/articles/">Articles</a>
                        </li>
                        <li class="nav-item">
                            <a {% if page.url == '/media/' %}id="current-page"{% endif %} class="nav-link" href="/media/">Media</a>
                        </li>
                        <li class="nav-item">
                            <a {% if page.url == '/videogames/' %}id="current-page"{% endif %} class="nav-link" href="/videogames/">Videogames</a>
                        </li>
                        <li class="nav-item">
                            <a {% if page.url == '/about-me/' %}id="current-page"{% endif %} class="nav-link" href="/about-me/">About Me</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>

        {% block controls %}
        {% if page.url != "/" %}
        <div class="container-fluid">
            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3">
                <div class="d-flex align-items-center">
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item"><a href="/">Home</a></li>
                            <li class="breadcrumb-item active" aria-current="page">
                                {{ title }}
                            </li>
                        </ol>
                    </nav>
                </div>
                <div class="d-flex justify-content-end gap-2 filters">
                    {% if hasFilters %}
                    <div class="dropdown">
                        <button class="btn dropdown-toggle" type="button" id="collectionDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                            Collection
                        </button>
                        <ul id="collection-list-root" class="dropdown-menu" aria-labelledby="collectionDropdown">
                        </ul>
                    </div>
                    <div class="dropdown">
                        <button class="btn dropdown-toggle" type="button" id="sortingDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                            Sort
                        </button>
                        <ul class="dropdown-menu" aria-labelledby="sortingDropdown">
                            <li><a class="dropdown-item" id="sort-new-old">Sort by date [new - old]</a></li>
                            <li><a class="dropdown-item" id="sort-old-new">Sort by date [old - new]</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item current-sort" id="sort-default">Sort by featured [best viewed first]</a></li>
                        </ul>
                    </div>
                    {% endif %}
                </div>
            </div>
        </div>
        {% endif %}
        {% endblock %}

        <main>
            {{ content | safe }}
        </main>

        {% block backstory %}
        {% endblock %}

        <div id="progress-bar"></div>

        <div id="scroll-to-top" class="d-flex justify-content-center align-items-center">
            <i class="fas fa-chevron-up fa-lg"></i>
        </div>

        <footer class="footer">
            <div class="container">
                <div class="row">
                    <div class="col-12 d-flex flex-column align-items-center justify-content-center">
                        <div class="footer-icons-row d-flex justify-content-center">
                            <a href="https://linktr.ee/Daniooo" aria-label="All my links" target="_blank" class="footer-icon" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="All my links">
                                <span class="fa-stack">
                                    <i class="fa-solid fa-circle fa-stack-2x" style="color: #43E660;"></i>
                                    <i class="fa-solid fa-arrow-up-right-from-square fa-stack-1x fa-inverse"></i>
                                </span>
                            </a>
                            <a href="https://youtube.com/c/Daniooo" aria-label="Subscribe to my YouTube channel" target="_blank" class="footer-icon" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="Subscribe to my YouTube channel">
                                <span class="fa-stack">
                                    <i class="fa-solid fa-circle fa-stack-2x" style="color: #FF0000;"></i>
                                    <i class="fa-brands fa-youtube fa-stack-1x fa-inverse"></i>
                                </span>
                            </a>                
                            <a href="https://github.com/0xdaniooo" aria-label="Check out my portfolio on GitHub" target="_blank" class="footer-icon" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="Check out my portfolio on GitHub">
                                <span class="fa-stack">
                                    <i class="fa-solid fa-circle fa-stack-2x" style="color: #000000;"></i>
                                    <i class="fa-brands fa-github fa-stack-1x fa-inverse"></i>
                                </span>
                            </a>
                            <a href="https://open.spotify.com/user/danio1243" aria-label="Listen to my playlists" target="_blank" class="footer-icon" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="Listen to my playlists">
                                <span class="fa-stack">
                                    <i class="fa-solid fa-circle fa-stack-2x" style="color: #1DD05D;"></i>
                                    <i class="fa-brands fa-spotify fa-stack-1x fa-inverse"></i>
                                </span>
                            </a>
                            <a href="https://www.linkedin.com/in/daniel-kasprzyk7/" aria-label="Connect with me on LinkedIn" target="_blank" class="footer-icon" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="Connect with me on LinkedIn">
                                <span class="fa-stack">
                                    <i class="fa-solid fa-circle fa-stack-2x" style="color: #0077B5;"></i>
                                    <i class="fa-brands fa-linkedin fa-stack-1x fa-inverse"></i>
                                </span>
                            </a>
                            <a href="https://www.instagram.com/0xdaniooo/" aria-label="Follow my Instagram" target="_blank" class="footer-icon" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="Follow my Instagram">
                                <span class="fa-stack">
                                    <i class="fa-solid fa-circle fa-stack-2x" style="color: #AE31BC;"></i>
                                    <i class="fa-brands fa-instagram fa-stack-1x fa-inverse"></i>
                                </span>
                            </a>
                            <a href="mailto:daniel.kasprzyk@daniooo.com" aria-label="Contact me via email" target="_blank" class="footer-icon" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="Contact me via email">
                                <span class="fa-stack">
                                    <i class="fa-solid fa-circle fa-stack-2x" style="color: #6D4AFF;"></i>
                                    <i class="fa-solid fa-envelope fa-stack-1x fa-inverse"></i>
                                </span>
                            </a>
                        </div>
                        <p id="copyright-text" class="copyright-text mt-3 mb-0">
                            © Daniel Kasprzyk
                        </p>
                    </div>
                </div>
            </div>
        </footer>

        <script src="/javascript/base.js"></script>
        {% if script %}
        <script type="module" src="/javascript/{{ script }}"></script>
        {% endif %}
    </body>
</html>