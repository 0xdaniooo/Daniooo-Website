{
	"compilerOptions": {
		"target": "ES2020",
		"lib": [
			"DOM",
			"DOM.Iterable",
			"ES2020"
		],
		"module": "ES6",
		"rootDir": "./src/typescript",
		"outDir": "./src/javascript",
		"removeComments": true,
		"noEmitOnError": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"strict": true,
		"skipLibCheck": true
	},
	"include": [
		"src/typescript/**/*.ts"
	],
	"exclude": [
		"node_modules",
		"_site",
		"*.js"
	]
}